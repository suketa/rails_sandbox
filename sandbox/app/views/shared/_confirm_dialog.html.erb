<dialog id="turbo-confirm-dialog" closedby="any" class="confirm-dialog" aria-labelledby="turbo-confirm-title" aria-describedby="turbo-confirm-message">
  <header>
    <hgroup>
      <h3 id="turbo-confirm-title">Confirm</h3>
      <p id="turbo-confirm-message"></p>
    </hgroup>
  </header>
  <footer>
    <button type="button" commandfor="turbo-confirm-dialog" command="close">Cancel</button>
    <form method="dialog">
      <button type="submit" value="confirm">Confirm</button>
    </form>
  </footer>
</dialog>
