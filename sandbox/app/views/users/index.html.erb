<p style="color: green"><%= notice %></p>

<% content_for :title, "Users" %>

<h1>Users</h1>

<%= form_with url: users_path,  method: :get, data: {turbo_frame: "users"} do |form| %>
  <div>
    <%= form.label :search, "Name:" %>
    <%= form.text_field :name, value: params[:name] %>
    <%= form.submit "Search" %>
  </div>
<% end %>

<turbo-frame id="users">
  <div id="users">
    <% @users.each do |user| %>
      <%= render user %>
      <p>
      <%= link_to "Show this user", user %>
      </p>
    <% end %>
  </div>
</turbo-frame>

<%= link_to "New user", new_user_path %>
